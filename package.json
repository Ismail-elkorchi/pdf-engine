{
  "name": "@ismail-elkorchi/pdf-engine",
  "version": "0.1.0",
  "description": "Security-first cross-runtime PDF parsing, structured reading, and extraction engine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/pdf-engine.git"
  },
  "homepage": "https://github.com/Ismail-elkorchi/pdf-engine#readme",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/pdf-engine/issues"
  },
  "packageManager": "npm@11.8.0",
  "keywords": [
    "pdf",
    "parser",
    "reader",
    "extraction",
    "typescript",
    "jsr",
    "npm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ocr/tesseract": {
      "types": "./dist/ocr/tesseract.d.ts",
      "import": "./dist/ocr/tesseract.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint src jsr scripts test eslint.config.mjs --max-warnings=0",
    "lint:fix": "eslint src jsr scripts test eslint.config.mjs --fix --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:runtimes": "node scripts/verify-runtime-versions.mjs",
    "verify:runtimes:pinned": "node scripts/verify-runtime-versions.mjs --mode=pinned",
    "runtime:staleness": "node scripts/runtime-staleness-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run verify:runtimes",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:contracts": "node --experimental-strip-types --test test/contracts/*.test.ts",
    "test:property": "node --experimental-strip-types --test test/property/*.test.ts",
    "test:node:lower": "node --experimental-strip-types --test test/unit/*.test.ts test/contracts/*.test.ts test/property/*.test.ts",
    "test:coverage:node-lower": "c8 --all --src src --exclude 'test/**' --exclude 'scripts/**' --report-dir coverage/node-lower --reporter text-summary --reporter json-summary --reporter lcov npm run test:node:lower",
    "test:runtime:node": "node --experimental-strip-types test/runtime/run-portable-runtime-tests.ts --report=reports/test-runtime-node.json",
    "test:runtime:deno": "deno run --allow-read=./src,./test,./jsr --allow-write=./reports test/runtime/run-portable-runtime-tests.ts --report=reports/test-runtime-deno.json",
    "test:runtime:bun": "bun test/runtime/run-portable-runtime-tests.ts --report=reports/test-runtime-bun.json",
    "test:runtime:browser": "npm run build && node test/runtime/run-browser-runtime-tests.mjs --browser=chromium --report=reports/test-runtime-browser.json",
    "test:runtime:browser:firefox": "npm run build && node test/runtime/run-browser-runtime-tests.mjs --browser=firefox --report=reports/test-runtime-browser-firefox.json",
    "test:runtime:browser:webkit": "npm run build && node test/runtime/run-browser-runtime-tests.mjs --browser=webkit --report=reports/test-runtime-browser-webkit.json",
    "test:runtime:browser:compat": "npm run test:runtime:browser && npm run test:runtime:browser:firefox && npm run test:runtime:browser:webkit && node test/runtime/compare-browser-runtime-reports.mjs reports/test-runtime-browser.json reports/test-runtime-browser-firefox.json reports/test-runtime-browser-webkit.json",
    "test:runtime:all": "npm run test:runtime:node && npm run test:runtime:deno && npm run test:runtime:bun && node test/runtime/compare-runtime-reports.mjs reports/test-runtime-node.json reports/test-runtime-deno.json reports/test-runtime-bun.json && npm run test:runtime:browser:compat",
    "test:integration:node": "npm run build && npm run smoke:compiled:node && npm run smoke:web && npm run smoke:browser",
    "test:integration:deno": "npm run smoke:deno",
    "test:integration:bun": "npm run build && npm run smoke:compiled:bun",
    "test:integration": "npm run test:integration:node && npm run test:integration:deno && npm run test:integration:bun",
    "test:fuzz": "npm run build && node scripts/fuzz/run-fuzz.mjs",
    "test:all": "npm run build && npm run test:coverage:node-lower && npm run test:runtime:all && npm run test:integration && npm run test:fuzz",
    "smoke:web": "node scripts/smoke/web-bundle.mjs",
    "smoke:browser": "npm run build && node scripts/smoke/browser-runtime-smoke.mjs --browser=chromium --report=reports/smoke-browser-runtime.json",
    "smoke:browser:firefox": "npm run build && node scripts/smoke/browser-runtime-smoke.mjs --browser=firefox --report=reports/smoke-browser-runtime-firefox.json",
    "smoke:browser:webkit": "npm run build && node scripts/smoke/browser-runtime-smoke.mjs --browser=webkit --report=reports/smoke-browser-runtime-webkit.json",
    "smoke:compiled:node": "node scripts/smoke/runtime-smoke.mjs ../../dist/index.js node",
    "smoke:compiled:bun": "bun scripts/smoke/runtime-smoke.mjs ../../dist/index.js bun",
    "smoke:deno": "deno run --allow-read=./jsr,./src,./test/fixtures scripts/smoke/runtime-smoke.mjs ../../jsr/mod.ts deno",
    "check:ci": "npm run check && npm run test:all"
  },
  "dependencies": {
    "@peculiar/asn1-cms": "^2.8.0",
    "@peculiar/asn1-rsa": "^2.8.0",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "@peculiar/x509": "^2.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "c8": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-regexp": "^3.1.1",
    "fast-check": "^4.9.0",
    "playwright": "1.62.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
